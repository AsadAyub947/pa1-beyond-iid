{
  "config": {
    "seed": 6304,
    "use_pretrained": true,
    "dataset": {
      "name": "stl10",
      "root": "./data_cache",
      "image_size": 224,
      "num_classes": 10,
      "class_names": [
        "airplane",
        "bird",
        "car",
        "cat",
        "deer",
        "dog",
        "horse",
        "monkey",
        "ship",
        "truck"
      ]
    },
    "subset": {
      "n_test": 500,
      "train_val_split": 0.8
    },
    "backbones": {
      "resnet50": {
        "weights": "IMAGENET1K_V2",
        "feat_dim": 2048
      },
