        "feat_dim": 512
      }
    },
    "linear_head": {
      "lr": 0.001,
      "weight_decay": 0.0001,
      "max_epochs": 50,
      "early_stop_patience": 5,
      "batch_size": 32
    },
    "clip_zero_shot": {
      "prompt_template": "a photo of a {class}."
    },
    "color_bias": {
      "additional_transform": "hue_rotation",
      "hue_shift": 0.25
    },
    "cue_conflict": {
      "n_class_pairs": 5,
      "class_pairs": null,
      "per_direction": 20,
      "max_candidates_per_direction": 40,
      "backend": "adain_decoder",
      "weights_dir": "./weights",
      "style_strength": 1.0,
      "style_center_crop": 0.7,
      "optim_steps": 300,
      "optim_lr": 0.02,
      "rejection": {
        "std_min": 0.02,
        "texture_position_min": 0.5,
        "structure_margin_min": 0.0
      },
      "manual_rejections": []
    },
    "translation": {
      "displacements": [
        0,
        8,
        16,
        32
      ],
      "directions": [
        "up",
        "down",
        "left",
        "right"
      ]
    },
    "patch_shuffle": {
      "grid": 4
    },
    "representation": {
      "method": "tsne",
      "tsne_perplexity": 30,
      "umap_n_neighbors": 15,
      "umap_min_dist": 0.1
    },
    "paths": {
      "results_dir": "./results"
    }
  },
